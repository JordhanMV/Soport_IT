{
  "name": "inventario-soporte-escritorio",
  "version": "1.3.1",
  "private": true,
  "description": "Inventario local de soporte técnico para Windows",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "release": "electron-vite build && electron-builder --publish always",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.68.0",
    "@fluentui/react-icons": "^2.0.312",
    "@types/sql.js": "^1.4.9",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "mx.soporte.inventario",
    "productName": "Inventario de soporte",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "win": { "target": "nsis" },
    "publish": [{
      "provider": "github",
      "owner": "JordhanMV",
      "repo": "Soport_IT",
      "releaseType": "release"
    }]
  }
}
